# The realm's shapes: what may exist here. The first rule is the accessibility floor:
# every thing has a text description. Sealed: no verb may write it.
@prefix rm:   <https://iriref.org/resmud/core#> .
@prefix rms:  <https://iriref.org/resmud/space#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

<urn:resmud:realm:id:first:shape:item> a sh:NodeShape ;
    sh:targetClass rm:Item ;
    sh:property <urn:resmud:realm:id:first:shape:item:description> .

<urn:resmud:realm:id:first:shape:item:description>
    sh:path rm:description ;
    sh:minCount 1 ;
    sh:message "has no rm:description, and every thing needs a text description: give it one" .

<urn:resmud:realm:id:first:shape:character> a sh:NodeShape ;
    sh:targetClass rm:Character ;
    sh:property <urn:resmud:realm:id:first:shape:character:description> .

<urn:resmud:realm:id:first:shape:character:description>
    sh:path rm:description ;
    sh:minCount 1 ;
    sh:message "has no rm:description, and every character needs a text description: give it one" .

<urn:resmud:realm:id:first:shape:room> a sh:NodeShape ;
    sh:targetClass rms:Room ;
    sh:property <urn:resmud:realm:id:first:shape:room:description> .

<urn:resmud:realm:id:first:shape:room:description>
    sh:path rm:description ;
    sh:minCount 1 ;
    sh:message "has no rm:description, and every room needs a text description: give it one" .
