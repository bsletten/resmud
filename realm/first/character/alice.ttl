# A character's atom says who it is and where it is. What it carries is said by each
# carried thing's atom, so taking a thing writes one atom.
@prefix rm:   <https://iriref.org/resmud/core#> .
@prefix rms:  <https://iriref.org/resmud/space#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:resmud:character:id:alice> a rm:Character ;
    rdfs:label "Alice" ;
    rm:description "A traveler with ink on her fingers." .

<urn:resmud:room:id:kitchen> rms:contains <urn:resmud:character:id:alice> .
