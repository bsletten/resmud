# A thing's atom says what it is, and nothing about where it is: that is said by the atom
# of the room that contains it (content/{room}.ttl) or of the character that carries it
# (carries/{character}.ttl). So moving it never rewrites this atom.
@prefix rm:   <https://iriref.org/resmud/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:resmud:thing:id:lamp> a rm:Item ;
    rdfs:label "lamp" ;
    rm:description "A brass lamp, dull with age." .
