# A thing's atom says what it is and where it is: rms:contains from its room, or
# rm:carries from a character. Taking it rewrites this atom, and only this one.
@prefix rm:   <https://iriref.org/resmud/core#> .
@prefix rms:  <https://iriref.org/resmud/space#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:resmud:thing:id:lamp> a rm:Item ;
    rdfs:label "lamp" ;
    rm:description "A brass lamp, dull with age." .

<urn:resmud:room:id:kitchen> rms:contains <urn:resmud:thing:id:lamp> .
