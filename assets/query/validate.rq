# The realm's shapes, checked against one candidate atom: one line per violation, which a
# player reads: the thing's name (its rdfs:label, or its key), then the shape's sh:message,
# so the line names no IRI ("the pebble has no description, ..."). This answers the SHACL
# Core fragment the realm's shapes use (sh:targetClass, a predicate sh:path, sh:minCount,
# sh:message); a shape using anything else is not checked by it.
PREFIX sh:   <http://www.w3.org/ns/shacl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?line WHERE {
  GRAPH <urn:resmud:candidate:shape> {
    ?shape sh:targetClass ?class ; sh:property ?property .
    ?property sh:path ?path ; sh:minCount ?min .
    OPTIONAL { ?property sh:message ?message }
  }
  GRAPH <urn:resmud:candidate:data> { ?focus a ?class }
  OPTIONAL {
    SELECT ?focus ?path (COUNT(?value) AS ?count) WHERE {
      GRAPH <urn:resmud:candidate:data> { ?focus ?path ?value }
    }
    GROUP BY ?focus ?path
  }
  OPTIONAL {
    SELECT ?focus (MIN(STR(?label)) AS ?name) WHERE {
      GRAPH <urn:resmud:candidate:data> { ?focus rdfs:label ?label }
    }
    GROUP BY ?focus
  }
  FILTER(COALESCE(?count, 0) < ?min)
  BIND(CONCAT("the ", COALESCE(?name, STRAFTER(STR(?focus), ":id:")), " ",
       COALESCE(?message, CONCAT("needs at least ", STR(?min), " ",
                                 REPLACE(STR(?path), "^.*[#/:]", "")))) AS ?line)
}
ORDER BY ?line
